diff --git a/src/main/java/com/destroystokyo/paper/console/PaperConsole.java b/src/main/java/com/destroystokyo/paper/console/PaperConsole.java
index 147b842ed311ab0e1d6f3e71679ec325086b2a55..3f5efdbcbb60faa69cb975bd3ec161f0185cfaaa 100644
--- a/src/main/java/com/destroystokyo/paper/console/PaperConsole.java
+++ b/src/main/java/com/destroystokyo/paper/console/PaperConsole.java
@@ -33,7 +33,32 @@
             builder.parser(new BrigadierConsoleParser(this.server));
             builder.completionMatcher(new BrigadierCompletionMatcher());
         }
-        return super.buildReader(builder);
+        LineReader reader = super.buildReader(builder);
+        // Leaf start - console ghost text suggestions
+        if (org.dreeam.leaf.config.modules.misc.ConsoleGhostText.enabled) {
+            org.jline.terminal.Terminal terminal = reader.getTerminal();
+            String terminalType = terminal.getType();
+            boolean unsupportedTerminal = org.jline.terminal.Terminal.TYPE_DUMB.equals(terminalType) || org.jline.terminal.Terminal.TYPE_DUMB_COLOR.equals(terminalType);
+            if (!unsupportedTerminal) {
+                new org.jline.widget.AutosuggestionWidgets(reader).enable();
+            } else if (org.dreeam.leaf.config.modules.misc.ConsoleGhostText.forceEnableOnUnsupportedTerminal) {
+                org.dreeam.leaf.config.LeafConfig.LOGGER.warn(
+                    "misc.console-ghost-text.force-enable-on-unsupported-terminal is true, so ghost text is being force-enabled " +
+                        "even though the console terminal ({}) was detected as not supporting ANSI codes. If that detection is " +
+                        "correct, the console output will look broken: the raw ANSI escape sequences used to draw the ghost text " +
+                        "will be printed as literal garbage characters instead of being interpreted.",
+                    terminalType);
+                new org.jline.widget.AutosuggestionWidgets(reader).enable();
+            } else {
+                org.dreeam.leaf.config.LeafConfig.LOGGER.warn(
+                    "misc.console-ghost-text.enabled is true, but the console terminal ({}) does not support ANSI codes. " +
+                        "Ghost text suggestions require a real interactive terminal (PTY), not a dumb stdin/stdout pipe. Leaving it disabled. " +
+                        "Set misc.console-ghost-text.force-enable-on-unsupported-terminal to true to override this check.",
+                    terminalType);
+            }
+        }
+        // Leaf end - console ghost text suggestions
+        return reader;
     }

     @Override
