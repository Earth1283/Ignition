diff --git a/net/minecraft/server/level/WorldGenRegion.java b/net/minecraft/server/level/WorldGenRegion.java
index 015539951e2a6af0e7b50c05512d1f6200ef2797..7a9d5c1e3b8f42a6d0c1f7e9b6a4d2c8e5f1a3b7 100644
--- a/net/minecraft/server/level/WorldGenRegion.java
+++ b/net/minecraft/server/level/WorldGenRegion.java
@@ -286,9 +286,12 @@ public class WorldGenRegion implements WorldGenLevel {
         return null;
     }

+    private boolean hasUnsafeTerrainReadWarned = false; // Leaf - do not log unsafe terrain read during worldgen
+
     private void warnIfReadOutsideWriteZone(final int chunkX, final int chunkZ) {
         if (this.centerChunkX != chunkX || this.centerChunkZ != chunkZ) {
-            if (!this.isWithinWriteZone(chunkX, chunkZ)) {
+            if (org.galemc.gale.configuration.GaleGlobalConfiguration.get().logToConsole.unsafeTerrainRead && !this.hasUnsafeTerrainReadWarned && !this.isWithinWriteZone(chunkX, chunkZ)) { // Leaf - do not log unsafe terrain read during worldgen
+                this.hasUnsafeTerrainReadWarned = true; // Leaf - do not log unsafe terrain read during worldgen
                 int readDistance = Math.max(Math.abs(this.centerChunkX - chunkX), Math.abs(this.centerChunkZ - chunkZ));
                 String warning = "Detected unsafe terrain read during worldgen: reading from chunk ["
                     + chunkX
