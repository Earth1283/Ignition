diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index 4c1d9a6b2e7f38a05c9d6e2b1f4a7c8d9e0b1f3a..8e2a5c7d1b9f46e0a3c8d5f2e1b7a9c4d6f8e0b2 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -315,6 +315,7 @@ public final class RegionizedPlayerChunkLoader {
             }
             loader.update(); // can't invoke plugin logic
             loader.updateQueues(currTime);
+            org.dreeam.leaf.async.chunk.ChunkPrefetchScheduler.maybePrefetch(player, this.world); // Leaf - chunk prefetch predictor
         }
     }
 
diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index 3f9d5e1a7c2b48f06d9a3e5c1b7f4d8a2c6e0f9b..9b1f4a6c8e2d05b7a3c9f6e1d4b8a0c5e7f2d9a3 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -930,6 +930,7 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
             }
 
             ca.spottedleaf.moonrise.common.PlatformHooks.get().removePlayerFromDistanceMaps(this.level, player); // Paper - rewrite chunk system
+            org.dreeam.leaf.async.chunk.ChunkPrefetchScheduler.removePlayer(player); // Leaf - chunk prefetch predictor
         }
     }
 
